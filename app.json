{
  "expo": {
    "name": "DhwaniPay",
    "slug": "dhwanipay",
    "scheme": "dhwanipay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "./plugins/withNotificationListener.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "in.dhwanipay.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F9F6"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.dhwanipay.app"
    },
    "web": {
      "bundler": "metro"
    },
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#F7F9F6",
      "resizeMode": "contain"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6a8e786e-fe0b-48a0-97d9-88d83e992775"
      }
    }
  }
}

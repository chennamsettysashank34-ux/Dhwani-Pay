PORT=8080

# -------------------------------------------------------------
# 1. Supabase PostgreSQL & API Keys
# -------------------------------------------------------------
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_NAME=postgres

# -------------------------------------------------------------
# 2. Razorpay Configuration (https://dashboard.razorpay.com)
# -------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# -------------------------------------------------------------
# 3. Cashfree Configuration (https://merchant.cashfree.com)
# -------------------------------------------------------------
CASHFREE_APP_ID=YourCashfreeAppIdHere
CASHFREE_SECRET_KEY=YourCashfreeSecretKeyHere
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_SECRET=YourCashfreeClientSecretHere
